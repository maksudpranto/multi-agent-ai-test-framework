DATABASE_URL=sqlite:///./app.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- AI backend ----------------------------------------------------------
# LLM_PROVIDER selects which model powers every agent.
#   gemini    -> Google Gemini (free tier). Set GEMINI_API_KEY.
#   anthropic -> Claude (paid).             Set ANTHROPIC_API_KEY.
#   ollama    -> local model, offline/free. Needs Ollama running.
#   mock      -> deterministic offline stub (NOT real AI; for tests/dev only).
# When a real provider is chosen, DEFAULT_LLM_MODEL may be left blank and a
# sensible per-provider default is used automatically.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=gemini-flash-latest

CORS_ORIGINS=http://localhost:5173
